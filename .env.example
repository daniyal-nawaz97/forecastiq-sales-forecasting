# Copy to .env. Everything is optional.

# Public address of this app (for the "Open dashboard" link in report emails)
PUBLIC_BASE_URL=
# PORT=8004

# Email for the monthly forecast report (any SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Landing page buttons (leave empty to open the demo)
CONTACT_EMAIL=
CONTACT_WHATSAPP=

# Real client install: DEMO_MODE=0 plus an admin login (use a fresh data/ folder)
DEMO_MODE=1
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_EMAIL=demo@forecastiq.app
DEMO_PASSWORD=demo1234
